# Pi app (apps/pi) build-time settings. Copy to .env.local for local work; never commit real values.
#
# NEXT_PUBLIC_ variables are read when the app is BUILT (next build) and baked into the browser
# bundle. Changing one needs a rebuild, not just a restart.

# Address of the Owner OS staff app (origin only, no trailing path), for example
# https://os.example.com. When set, the conversation panel of a staff member shows a
# "Staff review" link to <this>/pi/review?c=<conversation id> in the staff app.
# When unset or not a valid http(s) address, the link opens the Pi app's own review page
# (/brain/review?c=<conversation id>) instead, so it never goes nowhere.
# NEXT_PUBLIC_OWNER_OS_URL=http://localhost:3000

# Where the Pi app proxies /api/v1/pi-app to (build-time rewrite). Default http://127.0.0.1:8000.
# API_PROXY_TARGET=http://127.0.0.1:8000
