# Local development only. Replace the example password before shared use.
APP_ENV=development
POSTGRES_USER=platform
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=platform
DATABASE_URL=postgresql+asyncpg://platform:local-development-only@localhost:5432/platform
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DEPENDENCY_TIMEOUT_SECONDS=3

# Sessions. Cookies are Secure automatically in production.
# ALLOW_REGISTRATION=true
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# The web app proxies /api/v1, so the API sees one proxy hop.
TRUSTED_PROXY_HOPS=1

# Background jobs: "arq" (Redis) in production. "inline" runs jobs in-process for local
# development/tests only and is rejected when APP_ENV=production.
JOB_QUEUE_MODE=arq

# Fernet key for secrets stored at rest (e.g. WhatsApp access tokens). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=

# AI gateway: provider order and model aliases are configuration, never code.
PRIMARY_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=gemini
SECONDARY_FALLBACK_LLM_PROVIDER=groq
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Alias -> model id per provider (JSON). Aliases: router, agent, summarize, vision, embed,
# transcribe (legacy names fast/balanced/embedding/stt still resolve). "" disables an alias.
# Unlisted aliases use documented registry defaults unless AI_USE_DEFAULT_MODELS=false.
# OPENAI_MODELS={"router":"<model-id>","agent":"<model-id>","embedding":"<model-id>"}
# GEMINI_MODELS={"router":"<model-id>","agent":"<model-id>"}
# GROQ_MODELS={"router":"<model-id>"}
# AI_USE_DEFAULT_MODELS=true   (unset: on, except APP_ENV=test)
# GROQ_STRUCTURED_OUTPUT=json_object
# Resilience: circuit opens after N consecutive transient failures for a cooldown.
# LLM_MAX_RETRIES=1
# LLM_CIRCUIT_FAILURE_THRESHOLD=3
# LLM_CIRCUIT_COOLDOWN_SECONDS=30
# LLM_RETRY_AFTER_MAX_SECONDS=2
# Cost table (USD per 1M tokens) and optional per-tenant UTC-day budgets.
# AI_MODEL_PRICES={"openai:<model-id>":{"input":"0.15","output":"0.60"}}
# AI_TENANT_DAILY_TOKEN_LIMIT=2000000
# AI_TENANT_DAILY_COST_LIMIT=5.00

# WhatsApp Cloud API (platform-level app credentials).
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Web app. "live" uses the API through the same-origin /api/v1 proxy; anything else runs
# the UI on in-browser sample data (clearly marked in the UI) for local UI work.
NEXT_PUBLIC_DATA_MODE=live
API_PROXY_TARGET=http://localhost:8000

# PostgreSQL isolation tests: point at a migrated disposable database ending _test.
# TEST_DATABASE_URL=postgresql+asyncpg://test-user:test-password@localhost:5432/platform_test
