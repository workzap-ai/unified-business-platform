# Local development only. Replace the example password before shared use.
APP_ENV=development
POSTGRES_USER=platform
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=platform
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_JAWS2CyFjpv1@ep-square-rice-b4zteqeb-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon (the managed database for shared and production environments). Paste the
# connection strings from the Neon console as-is; SSL, pooling and prepared-statement
# handling are derived from them:
# DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL=postgresql://neondb_owner:npg_JAWS2CyFjpv1@ep-square-rice-b4zteqeb.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# For docker compose containers use DATABASE_URL_COMPOSE / MIGRATION_DATABASE_URL_COMPOSE
# (the plain names above are what host-run API/worker/alembic commands read).
# Optional overrides: DATABASE_SSL=require|verify-full|prefer|disable,
# DATABASE_POOLED=true|false, DATABASE_SSL_ROOT_CERT=/path/ca.pem
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
# DATABASE_IP_FAMILY=ipv4   # set on networks without working IPv6 (auto by default)
DEPENDENCY_TIMEOUT_SECONDS=3

# Sessions. Cookies are Secure automatically in production.
# ALLOW_REGISTRATION=true
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# The web app proxies /api/v1, so the API sees one proxy hop.
TRUSTED_PROXY_HOPS=1

# Background jobs: "arq" (Redis) in production. "inline" runs jobs in-process for local
# development/tests only and is rejected when APP_ENV=production.
JOB_QUEUE_MODE=inline

# Fernet key for secrets stored at rest (e.g. WhatsApp access tokens). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=

# AI gateway: provider order and model aliases are configuration, never code.
PRIMARY_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=gemini
SECONDARY_FALLBACK_LLM_PROVIDER=groq
# OPENAI_API_KEY= OPENAI_API_KEY
# GEMINI_API_KEY= GEMINI_API_KEY
# GROQ_API_KEY= GROQ_API_KEY
# Alias -> model id per provider (JSON). Aliases: router, agent, summarize, vision, embed,
# transcribe (legacy names fast/balanced/embedding/stt still resolve). "" disables an alias.
# Unlisted aliases use documented registry defaults unless AI_USE_DEFAULT_MODELS=false.
OPENAI_MODELS={"fast":"gpt-5.6-mini","balanced":"gpt-5.6","reasoning":"gpt-5.6","vision":"gpt-5.6"}
GEMINI_MODELS={"fast":"gemini-2.5-flash","balanced":"gemini-2.5-pro","reasoning":"gemini-2.5-pro","vision":"gemini-2.5-pro"}
GROQ_MODELS={"fast":"llama-4-scout","balanced":"llama-4-maverick"}
# AI_USE_DEFAULT_MODELS=true   (unset: on, except APP_ENV=test)
# GROQ_STRUCTURED_OUTPUT=json_object
# Resilience: circuit opens after N consecutive transient failures for a cooldown.
# LLM_MAX_RETRIES=1
# LLM_CIRCUIT_FAILURE_THRESHOLD=3
# LLM_CIRCUIT_COOLDOWN_SECONDS=30
# LLM_RETRY_AFTER_MAX_SECONDS=2
# Cost table (USD per 1M tokens) and optional per-tenant UTC-day budgets.
# AI_MODEL_PRICES={"openai:<model-id>":{"input":"0.15","output":"0.60"}}
# AI_TENANT_DAILY_TOKEN_LIMIT=2000000
# AI_TENANT_DAILY_COST_LIMIT=5.00

# WhatsApp Cloud API (platform-level app credentials).
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_VERSION=v21.0

# --- Integrations (see docs/INTEGRATIONS.md) ---
# Production refuses to start without SECRETS_ENCRYPTION_KEY while this is true.
# INTEGRATIONS_ENABLED=true
# Retired Fernet keys that may still decrypt stored credentials (comma-separated). Keep a
# single key in SECRETS_ENCRYPTION_KEY until PI's legacy helper supports key lists.
# SECRETS_ENCRYPTION_PREVIOUS_KEYS=
# Public HTTPS origin providers use to reach inbound webhooks
# (/api/v1/webhooks/{integration_key}/{endpoint_token}).
# INTEGRATIONS_PUBLIC_BASE_URL=https://api.example.com
# OAuth redirect URI = this origin + /api/v1/integrations/oauth/callback (register exactly).
# OAUTH_REDIRECT_BASE_URL=https://app.example.com
# OAUTH_STATE_TTL_SECONDS=600
# Outbound HTTP policy (all provider calls): timeouts, response cap, TLS (always on in prod).
# OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
# OUTBOUND_READ_TIMEOUT_SECONDS=15
# OUTBOUND_TOTAL_TIMEOUT_SECONDS=30
# OUTBOUND_MAX_RESPONSE_BYTES=2097152
# OUTBOUND_VERIFY_TLS=true
# Development/test only: hosts reachable over plain http (e.g. a local MinIO or mock).
# OUTBOUND_HTTP_ALLOWLIST=["localhost"]
# Extra destination ports besides 443 (e.g. [8443]).
# OUTBOUND_ALLOWED_PORTS=[]
# Inbound webhooks: body cap, signed-timestamp replay window, stored payload retention.
# WEBHOOK_MAX_BODY_BYTES=1048576
# WEBHOOK_REPLAY_WINDOW_SECONDS=300
# WEBHOOK_PAYLOAD_RETENTION_DAYS=30
# WEBHOOK_STORED_PAYLOAD_MAX_BYTES=65536
# Outbound webhook deliveries (exponential backoff with jitter, then dead letter).
# DELIVERY_MAX_ATTEMPTS=8
# DELIVERY_BACKOFF_BASE_SECONDS=30
# DELIVERY_BACKOFF_MAX_SECONDS=21600
# OUTBOX_BATCH_SIZE=100
# Circuit breaker and provider rate limits (fallback applies per process without Redis).
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_COOLDOWN_SECONDS=60
# INTEGRATION_RATE_LIMIT_PER_MINUTE=120
# INTEGRATION_RATE_LIMIT_FALLBACK_PER_MINUTE=20
# Platform SMTP used when a workspace has no connected email integration.
# PLATFORM_SMTP_HOST=
# PLATFORM_SMTP_PORT=587
# PLATFORM_SMTP_USERNAME=
# PLATFORM_SMTP_PASSWORD=
# PLATFORM_SMTP_FROM=noreply@example.com
# PLATFORM_SMTP_SECURITY=starttls
# PLATFORM_SMTP_TIMEOUT_SECONDS=10
# Object storage defaults (S3-compatible connections).
# STORAGE_DEFAULT_REGION=us-east-1
# STORAGE_SIGNED_URL_TTL_SECONDS=900
# STORAGE_MAX_UPLOAD_BYTES=26214400
# STRIPE_API_BASE_URL=https://api.stripe.com
# API_KEY_MAX_PER_ENVIRONMENT=50

# Web app. "live" uses the API through the same-origin /api/v1 proxy; anything else runs
# the UI on in-browser sample data (clearly marked in the UI) for local UI work.
NEXT_PUBLIC_DATA_MODE=live
API_PROXY_TARGET=http://localhost:8000

# PostgreSQL isolation tests: point at a migrated disposable database ending _test.
# TEST_DATABASE_URL=postgresql+asyncpg://test-user:test-password@localhost:5432/platform_test
